AGENT_ENABLED=true
AGENT_PROVIDER=deepseek
AGENT_BASE_URL=
AGENT_API_KEY=replace_with_deepseek_key
AGENT_MODEL=deepseek-chat
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=4
AGENT_DEFAULT_MODE=chat

# Kimi / Moonshot alternative:
# AGENT_PROVIDER=kimi
# AGENT_BASE_URL=
# AGENT_API_KEY=replace_with_kimi_key
# AGENT_MODEL=kimi-k2.5

# OpenAI-compatible fallback, for example OpenRouter:
# AGENT_PROVIDER=openai_compatible
# AGENT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_API_KEY=replace_with_openrouter_key
# AGENT_MODEL=moonshotai/kimi-k2.5

# Local docs/tests without a live model:
# AGENT_ENABLED=false
