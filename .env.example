# =============================================================================
# Source Scraper — environment template (verified from codebase, NO secrets)
# =============================================================================
#
# How vars are actually read:
#   - API/Agent/Qdrant/collections → src/api/settings.py (Pydantic Settings)
#   - Scrapers/Wasabi/Alerts/Orchestrator → os.getenv in src/
#   - DOCKER_* → docker-compose only (maps into QDRANT_URL / FLARESOLVERR_URL)
#   - QDRANT__SERVICE__* → Qdrant container (docker-compose.qdrant.yml)
#
# LOCAL:  cp .env.example .env
# PROD:   split into .env.shared / .env.api / .env.scheduler (see sections)
#         docker compose -f docker-compose.deploy.yml -f docker-compose.prod.yml \
#           --profile scheduler up -d
#
# Generate: openssl rand -hex 32
# =============================================================================


# #############################################################################
# .env.shared  — API + scheduler + indexers
# #############################################################################

APP_ENV=production
ALLOW_AUTH_DISABLED=false

# --- Qdrant client (API + index jobs via get_settings()) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_TIMEOUT_SECONDS=30
QDRANT_LOCAL_INFERENCE_BATCH_SIZE=256

# Compose host → container (not read by Python directly):
# DOCKER_QDRANT_URL=http://qdrant-vector-db:6333

QDRANT_RECORDS_COLLECTION=prism_yield_records
QDRANT_KNOWLEDGE_COLLECTION=prism_yield_knowledge
QDRANT_PRICE_RECORDS_COLLECTION=openstat_price_records
QDRANT_PRICE_KNOWLEDGE_COLLECTION=openstat_price_knowledge
CORPUS_RAG_COLLECTION=agri_corpus_rag

EMBEDDING_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
EMBEDDING_DENSE_SIZE=384
HYBRID_PREFETCH_MULTIPLIER=4
HYBRID_FUSION=rrf

SCHEMA_VERSION=v1
CSV_SOURCE_RELPATH=prism_processed/prism_yield_export.csv
OPENSTAT_CSV_SOURCE_RELPATH=openstat_processed/openstat_table.csv


# #############################################################################
# .env.api  — FastAPI + Agent LLM (+ optional Chainlit UI)
# #############################################################################

API_AUTH_DISABLED=false

# Agent key must ALSO appear in API_KEYS_PUBLIC (see require_agent in auth.py)
# or use an admin key for agent calls.
API_KEYS_PUBLIC=replace-with-public-key,replace-with-agent-key
API_KEYS_ADMIN=replace-with-admin-key
API_KEYS_AGENT=replace-with-agent-key
AGENT_ALLOW_PUBLIC=false

API_TITLE=PRiSM API
API_VERSION=1.0.0
API_DOCS_ENABLED=false
API_LOG_JSON=true
API_LOG_LEVEL=INFO
# API_CORS_ORIGINS=https://your-frontend.example

RATE_LIMIT_READ=120/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_EXPORT=5/minute
RATE_LIMIT_HEALTH=60/minute
RATE_LIMIT_AGENT=10/minute

EXPORT_MAX_ROWS=100000
SUMMARY_CACHE_SIZE=256
DEFAULT_SEARCH_LIMIT=10
DEFAULT_MIN_SCORE=0.0

# --- Agent LLM (settings.py) ---
AGENT_ENABLED=true
AGENT_PROVIDER=deepseek
AGENT_BASE_URL=
AGENT_API_KEY=replace-with-llm-provider-key
AGENT_MODEL=deepseek-chat
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=4
AGENT_DEFAULT_MODE=tasklist
AGENT_SUMMARIZE_MAX_ROWS=10000

# --- JWT (optional; settings.py) ---
JWT_AUTH_ENABLED=false
JWT_REQUIRED_FOR_AGENT=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=

# --- Chainlit UI only (src/agent/ui_chainlit.py; not needed for API container) ---
# AGENT_UI_API_URL=http://127.0.0.1:8000/v1/agent/chat
# In Docker compose (profile ui): defaults to http://api:8000/v1/agent/chat
# AGENT_UI_API_KEY=replace-with-agent-key
# AGENT_UI_TIMEOUT_SECONDS=60


# #############################################################################
# .env.scheduler  — orchestrator / scrapers / Wasabi / alerts
# #############################################################################

# --- FlareSolverr (openstat/utils/bypass.py) ---
FLARESOLVERR_URL=http://flaresolverr:8191
# DOCKER_FLARESOLVERR_URL=http://host.docker.internal:8191

# Shared headless fallback (PinoyRice uses HEADLESS only — NOT PINOYRICE_HEADLESS)
HEADLESS=true
PRISM_HEADLESS=true
PHILRICE_HEADLESS=true
PHILRICE_NEWS_HEADLESS=true
IRRI_HEADLESS=true
OPENSTAT_HEADLESS=true

URL_ALLOW_PRIVATE_TARGETS=false

# Workflow flags (usually overridden by orchestrator.yaml per job)
PHILRICE=false
PHILRICE_NEWS=false
PINOYRICE=false
OPENSTAT=false
IRRI=false
PRISM=false

# Orchestrator logging / validation
ORCHESTRATOR_LOG_DIR=data/logs
ORCHESTRATOR_LOG_JSON=true
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_VALIDATE_QUALITY=true
VALIDATE_MIN_TEXT_CHARS=100
VALIDATE_MAX_EMPTY_LINE_PCT=5

# --- PhilRice ---
PHILRICE_STREAM_PROCESS=true
PHILRICE_WRITE_PER_FILE=false
# PHILRICE_DELETE_PDF_AFTER_CLEAN=
PHILRICE_DOWNLOADS_ONLY=true
PHILRICE_DELAY_PAGE=8
PHILRICE_DELAY_PDF=5
PHILRICE_MAX_PAGES=12
PHILRICE_MAX_SUB_VISIT=80
PHILRICE_MIN_CHUNK_CHARS=100
PHILRICE_MAX_CHUNK_CHARS=0
# PHILRICE_FRESH_CORPUS=true

# --- PhilRice News ---
PHILRICE_NEWS_STREAM_PROCESS=true
# PHILRICE_NEWS_DELETE_TXT_AFTER_PROCESS=
PHILRICE_NEWS_DELAY=6
PHILRICE_NEWS_ARTICLE_DELAY=8
PHILRICE_NEWS_POST_GOTO_MS=5000
PHILRICE_NEWS_LISTING_SETTLE_MS=6000
PHILRICE_NEWS_TIMEOUT_MS=90000
PHILRICE_NEWS_GOTO_RETRIES=3
PHILRICE_NEWS_MIN_CHUNK_CHARS=100
PHILRICE_NEWS_MAX_CHUNK_CHARS=0
PHILRICE_NEWS_FAIL_IF_INCOMPLETE=true
# PHILRICE_NEWS_FRESH_CORPUS=true

# --- PinoyRice (uses HEADLESS, not PINOYRICE_HEADLESS) ---
PINOYRICE_STREAM_PROCESS=true
# PINOYRICE_DELETE_PDF_AFTER_CLEAN=
PINOYRICE_DELAY_PAGE=2
PINOYRICE_DELAY_PDF=2
PINOYRICE_MIN_CONTENT_LEN=100
PINOYRICE_MIN_CHUNK_CHARS=100
PINOYRICE_MAX_CHUNK_CHARS=0
# PINOYRICE_UNWANTED_TEXTS=
# PINOYRICE_FRESH_CORPUS=true

# --- OpenSTAT ---
RESUME_CHECKPOINT=false
OPENSTAT_MAX_YEARS_PER_BATCH=4
# OPENSTAT_URLS=
OPENSTAT_WRITE_LINE_CORPUS=false
# UNWANTED_TEXTS=

# --- IRRI ---
IRRI_STREAM_PROCESS=true
# IRRI_DELETE_TXT_AFTER_PROCESS=
# IRRI_DELETE_PDF_AFTER_CLEAN=
IRRI_DELAY_PDF=2
IRRI_DELAY_AFTER_PAGE=3
IRRI_DELAY_PAGE=6
IRRI_RETRY_WAIT=40
IRRI_MAX_RETRIES=3
IRRI_RANDOM_EXTRA=8
IRRI_USE_CHROMIUM=false
IRRI_COOLDOWN_EVERY_N_PAGES=6
IRRI_COOLDOWN_SECONDS=90
IRRI_SKIP_COUNTRY_SEARCH=true
# IRRI_START_PAGE=
IRRI_MIN_CHUNK_CHARS=100
IRRI_MAX_CHUNK_CHARS=0
# IRRI_FRESH_CORPUS=true

# --- PRiSM ---
# PRISM_JOB=export_yield_csv
PRISM_EXPORT_DELAY=1.0
PRISM_EXPORT_JITTER=0.55
PRISM_EXPORT_RETRIES=5
PRISM_EXPORT_TIMEOUT=90
PRISM_EXPORT_YEAR_MIN=2018
PRISM_EXPORT_YEAR_MAX=2026
PRISM_EXPORT_COOLDOWN_EVERY=75
PRISM_EXPORT_COOLDOWN_SECONDS=12
PRISM_BROWSER_SAVE_CORPUS=false
PRISM_BROWSER_TABLES_CSV=false
# PRISM_URL=
# PRISM_URLS=
PRISM_SCRAPLING_MODE=stealth
PRISM_DELAY_PAGE=2
PRISM_MIN_CONTENT_LEN=100
PRISM_RESUME_CHECKPOINT=true
PRISM_IMPERSONATE=chrome
PRISM_HTTP3=false
PRISM_SOLVE_CLOUDFLARE=true
# PRISM_CONTENT_SELECTOR=
PRISM_ADAPTIVE=false
PRISM_AUTO_SAVE=false
PRISM_STEALTH_FETCHER_ADAPTIVE=true
PRISM_REWRITE_DATAPRODUCTS_TO_APP=true
PRISM_JS_SETTLE_SECONDS=8
PRISM_BROWSER_TABLE_MAX_COLS=32
PRISM_MIN_CHUNK_CHARS=100
PRISM_MAX_CHUNK_CHARS=1800

# --- Wasabi (src/storage/wasabi_store.py) — ON for automated backups ---
WASABI_ENABLED=true
WASABI_ACCESS_KEY=replace-with-wasabi-access-key
WASABI_SECRET_KEY=replace-with-wasabi-secret-key
WASABI_BUCKET=agent-scraper
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_CORPUS_PREFIX=corpus-data/
WASABI_CHECKPOINT_PREFIX=Checkpoint/
WASABI_QDRANT_PREFIX=qdrant-data/
WASABI_DATED_RETENTION=2
WASABI_BACKUP_FAIL_JOB=true

# --- Alerts (src/orchestrator/alerts.py; default ALERT_ENABLED=false in code — set true) ---
ALERT_ENABLED=true
ALERT_LOCAL_FILE=true
ALERT_INCLUDE_TRACEBACK=false
ALERT_ON_TIMEOUT=false
ALERT_ON_SUCCESS=true
ALERT_ON_WARNING=false
ALERT_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
ALERT_TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
ALERT_DISCORD_WEBHOOK_URL=replace-with-discord-webhook-url
# ALERT_NTFY_TOPIC=
# ALERT_NTFY_SERVER=https://ntfy.sh
# ALERT_WEBHOOK_URL=
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=


# #############################################################################
# Qdrant Docker server only (file beside docker-compose.qdrant.yml — NOT app .env)
# #############################################################################
# QDRANT_API_KEY=replace-with-qdrant-api-key
# (compose sets QDRANT__SERVICE__API_KEY from that value)
