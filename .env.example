# Source Scraper — sanitized environment template (no real secrets).
# Copy to .env for local dev or split into .env.shared / .env.api / .env.scheduler for prod.

# --- Runtime profile ---
APP_ENV=development
# ALLOW_AUTH_DISABLED=true  # only for explicit local override when APP_ENV is not dev/test

# --- API authentication ---
API_AUTH_DISABLED=false
API_KEYS_PUBLIC=replace-with-public-key
API_KEYS_ADMIN=replace-with-admin-key
# API_KEYS_AGENT=replace-with-agent-key
# AGENT_ALLOW_PUBLIC=false

# --- API ops ---
API_DOCS_ENABLED=false
API_LOG_JSON=true
API_LOG_LEVEL=INFO
# API_CORS_ORIGINS=https://your-frontend.example

# --- Rate limits ---
RATE_LIMIT_READ=120/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_EXPORT=5/minute
RATE_LIMIT_HEALTH=60/minute
RATE_LIMIT_AGENT=10/minute

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
# DOCKER_QDRANT_URL=http://host.docker.internal:6333

# --- Agent (optional) ---
AGENT_ENABLED=true
AGENT_PROVIDER=deepseek
AGENT_API_KEY=replace-with-llm-key
AGENT_MODEL=deepseek-chat
AGENT_SUMMARIZE_MAX_ROWS=10000
# JWT_AUTH_ENABLED=false
# JWT_REQUIRED_FOR_AGENT=false

# --- Orchestrator / scraper (scheduler) ---
FLARESOLVERR_URL=http://flaresolverr:8191
# URL_ALLOW_PRIVATE_TARGETS=false
# WASABI_ENABLED=false
# WASABI_ACCESS_KEY=
# WASABI_SECRET_KEY=

# --- Alerts (scheduler) ---
# ALERT_INCLUDE_TRACEBACK=false
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_DISCORD_WEBHOOK_URL=
